cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED MODULE_FILE OR NOT DEFINED TEST_ROOT)
 message(FATAL_ERROR "Explicit module and fixture parent paths are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef fixture_id)
set(TEST_ROOT "${TEST_ROOT}/run-${fixture_id}")
if(EXISTS "${TEST_ROOT}")
 message(FATAL_ERROR "Refusing to reuse a fixture directory")
endif()
if(NOT DEFINED RESULT_FILE)
 set(RESULT_FILE "${TEST_ROOT}/result.json")
endif()
include("${MODULE_FILE}")
foreach(dir equal older newer qt missing)
 file(MAKE_DIRECTORY "${TEST_ROOT}/${dir}/share/obs-deps")
endforeach()
file(WRITE "${TEST_ROOT}/equal/share/obs-deps/VERSION" "2026-07-15\r\n")
file(WRITE "${TEST_ROOT}/older/share/obs-deps/VERSION" "2025-07-15\n")
file(WRITE "${TEST_ROOT}/newer/share/obs-deps/VERSION" "2027-07-15\n")
file(WRITE "${TEST_ROOT}/qt/share/obs-deps/VERSION" "2026-07-15\r\n")
file(MAKE_DIRECTORY "${TEST_ROOT}/qt/lib/cmake/Qt6")
file(WRITE "${TEST_ROOT}/qt/lib/cmake/Qt6/Qt6Config.cmake" "# configuration existence marker only")
set(checks 0)
set(failures 0)
macro(check_found label expected)
 math(EXPR checks "${checks}+1")
 if(NOT "${found}" STREQUAL "${expected}")
  math(EXPR failures "${failures}+1")
  message(STATUS "FAIL ${label}: found='${found}' expected='${expected}'")
 endif()
endmacro()
set(label fixture)
set(dependency prebuilt)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/equal")
_check_deps_version("2026-07-15")
check_found(equal_version TRUE)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/older")
_check_deps_version("2026-07-15")
check_found(older_version FALSE)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/newer")
_check_deps_version("2026-07-15")
check_found(newer_version TRUE)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/missing")
_check_deps_version("2026-07-15")
check_found(missing_after_true FALSE)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/equal")
_check_deps_version("2026-07-15")
check_found(equal_after_missing TRUE)
set(dependency qt6)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/equal")
_check_deps_version("2026-07-15")
check_found(non_qt_prefix FALSE)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/equal;${TEST_ROOT}/qt")
_check_deps_version("2026-07-15")
check_found(qt_after_nonqt TRUE)
set(dependency prebuilt)
set(CMAKE_PREFIX_PATH "${TEST_ROOT}/older;${TEST_ROOT}/equal")
_check_deps_version("2026-07-15")
check_found(reorder_old_prefix TRUE)
math(EXPR checks "${checks}+1")
if(NOT CMAKE_PREFIX_PATH STREQUAL "${TEST_ROOT}/equal;${TEST_ROOT}/older")
 math(EXPR failures "${failures}+1")
 message(STATUS "FAIL reorder-prefix list not propagated")
endif()
if(failures EQUAL 0)
 set(passed true)
else()
 set(passed false)
endif()
file(WRITE "${RESULT_FILE}" "{\"scope\":\"CMake helper semantics only; no fetch or frontend build\",\"checks\":${checks},\"failures\":${failures},\"passed\":${passed}}\n")
message(STATUS "checks=${checks} failures=${failures}")
if(failures)
 message(FATAL_ERROR "Dependency helper regression cases failed")
endif()
